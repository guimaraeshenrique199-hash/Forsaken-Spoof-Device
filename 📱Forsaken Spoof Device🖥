--========================================================--
-- DEVICE SPOOF
--========================================================--

local DeviceSpoof = {}
local ForcedDevice = "Console"
local Enabled = true

DeviceSpoof.Changed = Instance.new("BindableEvent").Event
DeviceSpoof.Value = ForcedDevice

local function ApplySpoof()
	if not Enabled then
		return
	end

	DeviceSpoof.Value = ForcedDevice

	pcall(function()
		Network:FireServerConnection(
			"SetDevice",
			"REMOTE_EVENT",
			ForcedDevice
		)
	end)
end

local function GetRealDevice()
	local Input = UserInputService:GetLastInputType()

	if Input == Enum.UserInputType.Touch then
		return "Mobile"
	end

	if Input == Enum.UserInputType.Gamepad1
		or Input == Enum.UserInputType.Gamepad2
		or Input == Enum.UserInputType.Gamepad3
		or Input == Enum.UserInputType.Gamepad4
		or Input == Enum.UserInputType.Gamepad5
		or Input == Enum.UserInputType.Gamepad6
		or Input == Enum.UserInputType.Gamepad7
		or Input == Enum.UserInputType.Gamepad8 then
		return "Console"
	end

	return "PC"
end

local function ResetSpoof()
	Enabled = false

	local RealDevice = GetRealDevice()

	pcall(function()
		Network:FireServerConnection(
			"SetDevice",
			"REMOTE_EVENT",
			RealDevice
		)
	end)
end

